---
# Enable all default checks, then filter using wildcards (- removes a check)
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  readability-*,
  performance-*,
  modernize-*,
  -readability-braces-around-statements,
  llvm-header-guard,
  llvm-namespace-comment,
  modernize-concat-nested-namespaces,
  misc-unused-includes

# Turn all matching warnings into hard compilation/build errors
WarningsAsErrors: 'bugprone-*,performance-*'

# Process headers matching this regex (usually your project headers, avoiding system headers)
HeaderFilterRegex: 'include/.*|src/.*'

# Keep searching parent directories if a setting isn't found here
InheritParentConfig: true

# Fine-tune specific checks using Key-Value pairs
CheckOptions:
  # Enforce curly braces for all loops and conditionals
  - key:             readability-braces-around-statements.ShortStatementLines
    value:           '1'
    
  # Enforce modern smart pointer generation functions
  - key:             modernize-replace-auto-ptr.IncludeStyle
    value:           'llvm'
    
  # Control strictness for function exit paths that shouldn't throw exceptions
  - key:             bugprone-exception-escape.FunctionsThatShouldNotThrow
    value:           'main,catch'

  # Configure style rules for naming variables, classes, and functions
  - key:             readability-identifier-naming.ClassCase
    value:           'CamelCase'
  - key:             readability-identifier-naming.ClassIgnoredRegexp
    value:           '^([A-Z]+_)[A-Z][a-zA-Z0-9]*$'
  - key:             readability-identifier-naming.VariableCase
    value:           'lower_case'
  - key:             readability-identifier-naming.FunctionCase
    value:           'camelBack'
  - key:             readability-identifier-naming.MethodCase
    value:           'camelBack'
    
  # Regular member variables
  - key:             readability-identifier-naming.MemberCase
    value:           'camelBack'
  - key:             readability-identifier-naming.MemberPrefix
    value:           'm_'

  # Const member variables
  - key:             readability-identifier-naming.MemberConstantCase
    value:           'CamelCase'
  - key:             readability-identifier-naming.MemberConstantPrefix
    value:           'm_'

  # For other (non-member) constants:
  - key:             readability-identifier-naming.GlobalConstantCase
    value:           'UPPER_CASE'
  - key:             readability-identifier-naming.StaticConstantCase
    value:           'CamelCase'
  - key:             readability-identifier-naming.LocalConstantCase
    value:           'CamelCase'

  # Don’t enforce naming rules for enums
  - key:            readability-identifier-naming.EnumCase
    value:          Ignored
  - key:            readability-identifier-naming.EnumConstantCase
    value:          Ignored
  - key:            readability-identifier-naming.ScopedEnumConstantCase
    value:          Ignored


  - key: llvm-header-guard.HeaderGuardPrefix
    value: ''                # no global prefix
  - key: llvm-header-guard.HeaderGuardMacroSeparator
    value: '_'               # join path components with underscores

  # Enforce strict naming conventions for all namespaces
  - key:             readability-identifier-naming.NamespaceCase
    value:           lower_case

  # Control how comments are automatically fixed or flagged
  - key:             llvm-namespace-comment.ShortNamespaceLines
    value:           0 # Only requires a closing comment if the namespace spans more than 0 lines
    
  - key:             llvm-namespace-comment.SpacesBeforeComments
    value:           1  # Adds exactly one space before the '// namespace name' comment
...
